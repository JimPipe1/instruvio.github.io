---
/**
 * STANDALONE PAGES — one per Markdown file in src/content/pages/.
 *
 * `about.md` becomes /about/, `process.md` becomes /process/, and so on.
 * Add `nav: true` to the file's frontmatter and it joins the header menu too.
 *
 * Adding a page is therefore a one-file job — no routing to wire up.
 */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import MediaFrame from '../components/MediaFrame.astro';
import { getPages } from '../lib/content.ts';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({
    params: { slug: page.id },
    props: page,
  }));
}

type Props = CollectionEntry<'pages'>;

const page = Astro.props;
const { title, description, eyebrow, hero, video } = page.data;
const { Content } = await render(page);
---

<Base title={title} description={description} image={hero}>
  <article class="section">
    <div class="container">
      <header class="page-head">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        <p class="page-head__lede">{description}</p>
      </header>

      {
        hero && (
          <div class="page-hero">
            <MediaFrame
              image={hero}
              video={video}
              alt=""
              ratio="21 / 9"
              mode={video ? 'once' : 'still'}
              loading="eager"
            />
          </div>
        )
      }

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .page-head {
    max-width: var(--container-narrow);
  }

  .page-head__lede {
    margin-top: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--step-2);
    line-height: 1.4;
  }

  .page-hero {
    margin-block: var(--space-2xl);
  }

  /* Without a hero image, the body copy still needs separating from the title. */
  .page-head + .prose {
    margin-top: var(--space-2xl);
  }
</style>
