---
/**
 * HOME PAGE
 *
 * This file contains no content of its own. It reads HOME_SECTIONS from
 * src/site.config.ts and renders each block with the matching component, in
 * the order listed there.
 *
 * To change the home page, edit HOME_SECTIONS — not this file.
 * To invent a brand new kind of section: build the component, then add it to
 * the SECTIONS map below and to the HomeSection type in site.config.ts.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Featured from '../components/sections/Featured.astro';
import Stats from '../components/sections/Stats.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Process from '../components/sections/Process.astro';
import Team from '../components/sections/Team.astro';
import Clients from '../components/sections/Clients.astro';
import CTA from '../components/sections/CTA.astro';
import { SITE, HOME_SECTIONS, type HomeSection } from '../site.config.ts';

/**
 * Maps a section's `type` to the component that renders it.
 *
 * Typed loosely on purpose: each component takes a different set of props, and
 * TypeScript cannot narrow a spread of the HomeSection union down to the one
 * component it is about to be handed. The schema in site.config.ts is what
 * keeps the two sides honest.
 */
const SECTIONS: Record<HomeSection['type'], any> = {
  hero: Hero,
  featured: Featured,
  stats: Stats,
  capabilities: Capabilities,
  process: Process,
  team: Team,
  clients: Clients,
  cta: CTA,
};
---

<Base title={SITE.name} description={SITE.description}>
  {
    HOME_SECTIONS.map((section) => {
      const { type, ...props } = section;
      const Section = SECTIONS[type];

      // A typo in a section's `type` skips that block instead of failing the
      // whole build. The warning shows in the terminal running `npm run dev`.
      if (!Section) {
        console.warn(`[home] Unknown section type "${type}" — skipped.`);
        return null;
      }

      return <Section {...props} />;
    })
  }
</Base>
