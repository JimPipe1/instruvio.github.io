---
/**
 * PROJECT PAGE — one per Markdown file in src/content/projects/.
 *
 * The file's name becomes the URL: `riverside-tower.md` -> /work/riverside-tower/
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import { getProjects, getProjectNeighbours, withBase, type Project } from '../../lib/content.ts';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = Project;

const project: Props = Astro.props;
const { title, client, type, summary, poster, video, ratio, gallery, details, services, year } =
  project.data;

const { Content } = await render(project);
const { prev, next } = await getProjectNeighbours(project.id);

const typeLabel = { explainer: 'Explainer', cpd: 'CPD & training', product: 'Product & SaaS' }[type];

// The facts panel: the fixed fields first, then anything in `details`.
const facts: [string, string][] = [
  ['Client', client],
  ['Type', typeLabel],
  ...(year ? ([['Year', String(year)]] as [string, string][]) : []),
  ...Object.entries(details),
];
---

<Base title={title} description={summary} image={poster}>
  <article>
    {/* --- Lead media ------------------------------------------------ */}
    <div class="lead">
      <div class="container">
        <MediaFrame
          image={poster}
          video={video}
          alt={`${title} for ${client}`}
          ratio={ratio}
          mode={video ? 'play' : 'still'}
          loading="eager"
        />
      </div>
    </div>

    {/* --- Title and facts ------------------------------------------- */}
    <div class="section">
      <div class="container">
        <div class="intro">
          <div class="intro__main">
            <p class="eyebrow">{typeLabel}</p>
            <h1>{title}</h1>
            <p class="intro__summary">{summary}</p>

            <div class="prose intro__prose">
              <Content />
            </div>
          </div>

          <aside class="intro__aside">
            <dl class="facts">
              {
                facts.map(([label, value]) => (
                  <div class="facts__row">
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>

            {
              services.length > 0 && (
                <div class="services">
                  <h2 class="services__title">Services</h2>
                  <ul class="services__list">
                    {services.map((service) => (
                      <li class="pill">{service}</li>
                    ))}
                  </ul>
                </div>
              )
            }
          </aside>
        </div>
      </div>
    </div>

    {/* --- Gallery ---------------------------------------------------- */}
    {
      gallery.length > 0 && (
        <div class="section">
          <div class="container">
            <h2 class="visually-hidden">Gallery</h2>
            <div class="gallery">
              {gallery.map((item) => (
                <figure class:list={['gallery__item', `gallery__item--${item.span}`]}>
                  <MediaFrame
                    image={item.image}
                    video={item.video}
                    alt={item.alt}
                    ratio={item.span === 'wide' ? '16 / 9' : '3 / 2'}
                    mode={item.video ? 'play' : 'still'}
                  />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {/* --- Previous / next -------------------------------------------- */}
    {
      (prev || next) && (
        <nav class="section pager" aria-label="More projects">
          <div class="container pager__inner">
            {prev && (
              <a class="pager__link" href={withBase(`/work/${prev.id}/`)}>
                <span class="pager__label">← Previous</span>
                <span class="pager__title">{prev.data.title}</span>
              </a>
            )}
            {next && (
              <a class="pager__link pager__link--next" href={withBase(`/work/${next.id}/`)}>
                <span class="pager__label">Next →</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .lead {
    padding-top: var(--space-xl);
  }

  /* ------------------------------------------------------------ intro */

  .intro {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
  }

  /* Facts move into a sidebar once there is width for two columns. */
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-3xl);
    }
  }

  .intro__summary {
    max-width: 44ch;
    margin-top: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--step-2);
    line-height: 1.4;
  }

  .intro__prose {
    margin-top: var(--space-xl);
  }

  /* ------------------------------------------------------------ facts */

  .facts {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-size: var(--step--1);
  }

  .facts__row dt {
    color: var(--text-faint);
  }

  .facts__row dd {
    margin: 0;
    text-align: right;
  }

  .services {
    margin-top: var(--space-xl);
  }

  .services__title {
    margin-bottom: var(--space-md);
    color: var(--text-faint);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .services__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------------------------------------------------------- gallery */

  .gallery {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    /* A 'wide' item runs the full width of the gallery. */
    .gallery__item--wide {
      grid-column: 1 / -1;
    }
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__item figcaption {
    margin-top: var(--space-sm);
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  /* ------------------------------------------------------------ pager */

  .pager__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }

  .pager__label {
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .pager__title {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }
</style>
