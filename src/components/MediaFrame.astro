---
/**
 * One media slot: a still, or a video with the still as its poster frame.
 *
 * Behaviour by `mode`:
 *   'still' — always just the image.
 *   'hover' — poster image until the pointer is over it, then the video plays
 *             silently. On touch screens there is no hover, so the poster
 *             stays and a small "video" badge signals there is more to see.
 *   'auto'  — plays on a loop as soon as it scrolls into view.
 *   'once'  — plays through a single time when it scrolls into view, then
 *             holds its last frame. It never rewinds or replays. For heroes.
 *   'play'  — a normal video player with visible controls and sound.
 *
 * Every mode reserves the right amount of space up front using `aspect-ratio`,
 * so the page never jumps around while images load.
 */
import { withBase } from '../lib/content.ts';

interface Props {
  /** Still image path inside `public/`. Doubles as the video poster. */
  image: string;
  /** Optional video path inside `public/`. */
  video?: string;
  alt?: string;
  /** CSS aspect ratio, e.g. '16 / 9' or '3 / 2'. */
  ratio?: string;
  mode?: 'still' | 'hover' | 'auto' | 'once' | 'play';
  /** 'eager' for anything visible without scrolling; 'lazy' everywhere else. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  video,
  alt = '',
  ratio = '16 / 9',
  mode = 'still',
  loading = 'lazy',
  class: className,
} = Astro.props;

// Without a video file there is nothing to play, whatever the mode asked for.
const effectiveMode = video ? mode : 'still';
const showBadge = effectiveMode === 'hover';

// 'hover' and 'auto' fade a silent video in over a real <img>. The image has
// to be a separate element: a <video> paints its own poster, so fading the
// video out would take the poster with it and leave an empty box.
const isLayered =
  effectiveMode === 'hover' || effectiveMode === 'auto' || effectiveMode === 'once';

// 'once' is the one mode that must not repeat, so it is the one without `loop`.
const shouldLoop = effectiveMode !== 'once';
---

<div
  class:list={['media', `media--${effectiveMode}`, className]}
  style={`--ratio: ${ratio};`}
  data-media={effectiveMode}
>
  {
    (effectiveMode === 'still' || isLayered) && (
      <img class="media__img" src={withBase(image)} alt={alt} loading={loading} decoding="async" />
    )
  }

  {
    /*
     * preload="none" keeps the page light: the video file is only fetched once
     * it is actually needed, so a grid of twenty projects costs twenty small
     * images rather than twenty videos. aria-hidden is safe here because the
     * <img> above already carries the description.
     */
    isLayered && (
      <video
        class="media__video"
        muted
        loop={shouldLoop}
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase(video!)} type="video/mp4" />
      </video>
    )
  }

  {
    effectiveMode === 'play' && (
      <video
        class="media__video media__video--controls"
        poster={withBase(image)}
        controls
        playsinline
        preload="none"
        aria-label={alt || undefined}
      >
        <source src={withBase(video!)} type="video/mp4" />
      </video>
    )
  }

  {
    showBadge && (
      <span class="media__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
          <path d="M8 5v14l11-7z" />
        </svg>
        Video
      </span>
    )
  }
</div>

<style>
  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    background: var(--bg-sunken);
    border-radius: var(--radius-lg);
    /* A faint checker while the image loads, so an empty slot still reads as
       a picture frame rather than a hole in the layout. */
    background-image: linear-gradient(
      135deg,
      var(--surface) 0%,
      var(--bg-sunken) 50%,
      var(--surface) 100%
    );
  }

  .media__img,
  .media__video {
    width: 100%;
    height: 100%;
    /* Fill the frame and crop, rather than squash, whatever the source size. */
    object-fit: cover;
  }

  /* In the layered modes the video sits directly on top of the still and
     cross-fades in once it is actually playing. */
  .media--hover .media__video,
  .media--auto .media__video,
  .media--once .media__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .media--hover.is-playing .media__video,
  .media--auto.is-playing .media__video,
  .media--once.is-playing .media__video,
  /* Once it has finished, the final frame stays put for the rest of the visit. */
  .media--once.is-ended .media__video {
    opacity: 1;
  }

  .media__badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: rgb(0 0 0 / 60%);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: opacity var(--transition);
  }

  .media.is-playing .media__badge {
    opacity: 0;
  }

  /* A device with a real pointer can hover; a touch screen cannot. Hide the
     badge on desktop only once we know hover is available. */
  @media (hover: hover) and (pointer: fine) {
    .media__badge {
      opacity: 0;
    }

    .media:hover .media__badge {
      opacity: 1;
    }
  }
</style>

<script>
  /**
   * Video playback control, shared by every MediaFrame on the page.
   *
   * Three jobs:
   *  1. 'hover' videos play while the pointer is over them.
   *  2. 'auto' and 'once' videos play while they are on screen, and pause when
   *     they are scrolled away — this stops a page of animations draining a
   *     battery. 'once' stops for good on its last frame.
   *  3. Nothing plays by itself if the visitor prefers reduced motion.
   */
  const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  const play = (frame: HTMLElement) => {
    const video = frame.querySelector('video');
    if (!video) return;
    // play() rejects if the browser blocks it (low power mode, for example).
    // There is nothing to recover from, so we just keep the poster showing.
    video.play().then(
      () => frame.classList.add('is-playing'),
      () => {},
    );
  };

  const pause = (frame: HTMLElement) => {
    const video = frame.querySelector('video');
    if (!video) return;
    video.pause();
    frame.classList.remove('is-playing');
  };

  /* --- 1. Hover previews ------------------------------------------------ */

  if (canHover && !prefersReducedMotion) {
    for (const frame of document.querySelectorAll<HTMLElement>('[data-media="hover"]')) {
      /**
       * Listen on the whole card rather than the frame itself. A project card
       * stretches its title link across the entire tile to make it clickable,
       * and that overlay sits between the pointer and the frame — so the frame
       * would never see a mouseenter of its own.
       *
       * Any wrapper can opt in by adding a `data-media-hover` attribute.
       */
      const root = frame.closest<HTMLElement>('[data-media-hover]') ?? frame;

      root.addEventListener('mouseenter', () => play(frame));
      root.addEventListener('mouseleave', () => {
        pause(frame);
        const video = frame.querySelector('video');
        // Rewind so the next hover starts from the beginning.
        if (video) video.currentTime = 0;
      });
    }
  }

  /* --- 2 & 3. Autoplaying heroes --------------------------------------- */

  /*
   * 'auto' loops for as long as it is on screen. 'once' plays a single time and
   * then holds its last frame: it is never rewound, and scrolling back up does
   * not start it again.
   */
  const autoFrames = document.querySelectorAll<HTMLElement>(
    '[data-media="auto"], [data-media="once"]',
  );

  if (autoFrames.length > 0 && !prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const frame = entry.target as HTMLElement;
          if (entry.isIntersecting) play(frame);
          else pause(frame);
        }
      },
      { threshold: 0.2 },
    );

    for (const frame of autoFrames) {
      // preload="none" means the file has not been requested yet; asking for
      // metadata now lets the first frame be ready the moment it scrolls in.
      const video = frame.querySelector('video');
      if (video) video.preload = 'auto';

      if (frame.dataset.media === 'once' && video) {
        video.addEventListener(
          'ended',
          () => {
            // Stop watching it: nothing should ever pause, rewind or restart
            // it again, so the closing frame simply stays on screen.
            observer.unobserve(frame);
            frame.classList.add('is-ended');
          },
          { once: true },
        );
      }

      observer.observe(frame);
    }
  }
</script>
