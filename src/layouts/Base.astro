---
/**
 * The page shell every route is wrapped in: <head>, header, main, footer.
 * Pass the page's own content in as children.
 */
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Adds a class to <main>, used to let the hero sit under the header. */
  mainClass?: string;
}

const { title, description, image, noindex, mainClass } = Astro.props;
---

<!doctype html>
<html lang="en-IE">
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
